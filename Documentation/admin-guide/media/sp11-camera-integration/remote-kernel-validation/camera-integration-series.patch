From 4e82f0d2e74816b430438f544864233dc7010415 Mon Sep 17 00:00:00 2001
From: Leon Silcott <lnsilcott@gmail.com>
Date: Thu, 27 Aug 2026 12:33:19 +0100
Subject: [PATCH 2/2] media: qcom: camss: select MIPI RAW mode for VFE680 RDI

Select the MIPI_RAW write-client mode used in Jeroen Karsies' SP11 camera
bring-up snapshot b08f76f40b8d7b715bd4da6aef484f86142cc147. Name the mode
bit and set it together with the existing write-client enable bit.

Keep stride, image configuration, packing, frame increment, interrupts
and stream lifecycle unchanged. This does not establish alignment padding
for unaligned packed RAW widths and does not enable any sensor.

Retain the existing upstream source attribution. This register-mode
adaptation remains experimental until VFE680 stream status and capture
layout are validated on the target hardware.

Link: https://github.com/karsies-wq/sp11-imx681-linux/blob/b08f76f40b8d7b715bd4da6aef484f86142cc147/camss/camss-vfe-680.c
---
 drivers/media/platform/qcom/camss/camss-vfe-680.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-680.c b/drivers/media/platform/qcom/camss/camss-vfe-680.c
index 99036e7c1e76..0d228bc3032b 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-680.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-680.c
@@ -38,6 +38,7 @@
 
 #define VFE_BUS_WRITE_CLIENT_CFG(vfe, c)	((vfe_is_lite(vfe) ? 0x400 : 0xe00) + (c) * 0x100)
 #define		VFE_BUS_WRITE_CLIENT_CFG_EN	BIT(0)
+#define		VFE_BUS_WRITE_CLIENT_CFG_MODE_MIPI_RAW	BIT(16)
 #define VFE_BUS_IMAGE_ADDR(vfe, c)		((vfe_is_lite(vfe) ? 0x404 : 0xe04) + (c) * 0x100)
 #define VFE_BUS_FRAME_INCR(vfe, c)		((vfe_is_lite(vfe) ? 0x408 : 0xe08) + (c) * 0x100)
 #define VFE_BUS_IMAGE_CFG0(vfe, c)		((vfe_is_lite(vfe) ? 0x40c : 0xe0c) + (c) * 0x100)
@@ -186,7 +187,8 @@ static void vfe_wm_start(struct vfe_device *vfe, u8 rdi, struct vfe_line *line)
 	vfe_disable_irq(vfe);
 
 	/* Enable WM */
-	writel(VFE_BUS_WRITE_CLIENT_CFG_EN,
+	writel(VFE_BUS_WRITE_CLIENT_CFG_EN |
+	       VFE_BUS_WRITE_CLIENT_CFG_MODE_MIPI_RAW,
 	       vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm));
 
 	dev_dbg(vfe->camss->dev, "RDI%d WM:%d width %d height %d stride %d\n",
-- 
